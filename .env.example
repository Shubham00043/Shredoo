# ==============================================================================
# SHREDoo – Environment Configuration Template (Vercel & Local)
# ==============================================================================
# Copy these environment variables into your Vercel Project Settings:
# Settings -> Environment Variables -> Add All
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Route Redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# 2. Super Admin Access
# ------------------------------------------------------------------------------
# Set to your verified Clerk User ID (found in Clerk Dashboard -> Users -> ID: user_...)
SUPER_ADMIN_CLERK_ID=user_...

# ------------------------------------------------------------------------------
# 3. LiveKit Real-Time WebRTC Voice & Audio
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 4. Music Providers
# ------------------------------------------------------------------------------
# Jamendo Client ID for authorized Creative Commons streaming
JAMENDO_CLIENT_ID=56d30c95

# Optional: Bollywood B2B Licensed Provider Endpoint
BOLLYWOOD_PROVIDER_API_KEY=
BOLLYWOOD_PROVIDER_ENDPOINT=https://api.partner-licensing.com/v1
